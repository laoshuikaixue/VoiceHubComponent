<ci:ComponentBase x:Class="VoiceHubComponent.Views.VoiceHubSettingsView"
                x:TypeArguments="models:VoiceHubSettings"
                x:DataType="models:VoiceHubSettings"
                xmlns="https://github.com/avaloniaui"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:ci="http://classisland.tech/schemas/xaml/core"
                xmlns:fluent="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
                xmlns:models="clr-namespace:VoiceHubComponent.Models">
    <ScrollViewer>
        <StackPanel Margin="16" Spacing="8">
            <TextBlock Text="VoiceHub 插件设置" 
                       FontSize="20"
                       FontWeight="SemiBold"
                       Margin="0,0,0,16"/>

            <fluent:SettingsExpander Header="API 地址"
                                     Description="设置 VoiceHub API 的公开接口地址。"
                                     IconSource="{ci:FluentIconSource &#xE71B;}">
                <fluent:SettingsExpander.Footer>
                    <TextBox x:Name="ApiUrlTextBox"
                             Text="{Binding ApiUrl}"
                             Watermark="请输入 VoiceHub API 地址"
                             Width="300"
                             VerticalAlignment="Center"/>
                </fluent:SettingsExpander.Footer>
            </fluent:SettingsExpander>
            
            <TextBlock Text="默认: https://voicehub.lao-shui.top/api/songs/public"
                       FontSize="12"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Margin="16,0,0,0"/>

            <fluent:SettingsExpander Header="歌词显示"
                                     Description="按排期顺序和固定开始时间，在组件上显示当前歌词行。"
                                     IconSource="{ci:FluentIconSource &#xE3E3;}">
                <fluent:SettingsExpander.Footer>
                    <CheckBox x:Name="EnableLyricsCheckBox"
                              IsChecked="{Binding EnableLyrics}"
                              Content="启用歌词显示"
                              VerticalAlignment="Center"/>
                </fluent:SettingsExpander.Footer>
            </fluent:SettingsExpander>

            <fluent:SettingsExpander Header="固定开始时间"
                                     Description="当天第一首排期歌曲开始播放的时间，支持 HH:mm 或 HH:mm:ss。"
                                     IconSource="{ci:FluentIconSource &#xE823;}">
                <fluent:SettingsExpander.Footer>
                    <TextBox x:Name="BroadcastStartTimeTextBox"
                             Text="{Binding BroadcastStartTime}"
                             Watermark="例如 12:20:00"
                             Width="160"
                             VerticalAlignment="Center"/>
                </fluent:SettingsExpander.Footer>
            </fluent:SettingsExpander>

            <fluent:SettingsExpander Header="调试排期日期"
                                     Description="仅用于测试。启用后，组件会按指定日期加载排期。"
                                     IconSource="{ci:FluentIconSource &#xE4C5;}">
                <fluent:SettingsExpander.Footer>
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <CheckBox x:Name="UseDebugScheduleDateCheckBox"
                                  Content="启用"
                                  IsChecked="{Binding UseDebugScheduleDate}"
                                  VerticalAlignment="Center"/>
                        <CalendarDatePicker x:Name="DebugScheduleDatePicker"
                                            SelectedDate="{Binding DebugScheduleDate}"
                                            Width="150"
                                            VerticalAlignment="Center"/>
                    </StackPanel>
                </fluent:SettingsExpander.Footer>
            </fluent:SettingsExpander>

            <fluent:SettingsExpander Header="网易云音乐 Cookie"
                                     Description="可选。填写后获取网易云播放地址和时长时会携带 Cookie。"
                                     IconSource="{ci:FluentIconSource &#xE8D1;}">
                <fluent:SettingsExpander.Footer>
                    <TextBox x:Name="NeteaseCookieTextBox"
                             Text="{Binding NeteaseCookie}"
                             Watermark="MUSIC_U=...; ..."
                             PasswordChar="●"
                             Width="300"
                             VerticalAlignment="Center"/>
                </fluent:SettingsExpander.Footer>
            </fluent:SettingsExpander>

            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,16,0,0">
                <Button x:Name="SaveButton"
                        Content="保存配置"
                        Classes="accent"
                        Click="SaveButton_Click"/>
                
                <Button x:Name="RefreshButton"
                        Content="刷新组件"
                        Click="RefreshButton_Click"/>

                <Button x:Name="ForceLyricsRefreshButton"
                        Content="重新获取歌词"
                        Click="ForceLyricsRefreshButton_Click"/>

                <Button x:Name="TestConnectionButton"
                        Content="测试连接"
                        Click="TestConnectionButton_Click"/>
                
                <Button x:Name="ResetButton"
                        Content="重置为默认"
                        Click="ResetButton_Click"/>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</ci:ComponentBase>
